# SmartPredict configuration template.
#
# Copy to `.env` in the project root and fill in real values:
#     cp .env.example .env
# `.env` is gitignored. Real environment variables always win over this file.

# ============================================================
# RUNTIME
# ============================================================

# "development" or "production". In production the API refuses to start
# without strong secrets and a bootstrap administrator password.
ENVIRONMENT=development

# ============================================================
# SECRETS (required in production, generated per-process in development)
# ============================================================

# At least 32 characters. Used to sign JWT access tokens.
JWT_SECRET_KEY=

# At least 32 characters, and must differ from JWT_SECRET_KEY.
# Only needed for cookie-based sessions; the API uses bearer tokens today.
CSRF_SECRET_KEY=

# Password for the automatically created first Admin account.
# Only used when the users table is empty. Minimum 12 characters with
# upper case, lower case, a digit and a symbol.
INITIAL_ADMIN_PASSWORD=

# Email address for that first Admin account.
INITIAL_ADMIN_EMAIL=admin@smartpredict.io

# ============================================================
# DATABASE
# ============================================================

# Override the SQLite file location (defaults to notification_data.db in the
# project root). Handy for running the API against a scratch database.
# SMARTPREDICT_DB_PATH=./notification_data.db

# ============================================================
# SESSIONS & RATE LIMITS
# ============================================================

# Access token lifetime in minutes (default 120).
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Requests per window, per client (default window is 60 seconds).
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_PREDICT=60

# ============================================================
# CORS (comma-separated, no trailing slashes)
# ============================================================

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# FRONTEND (Vite only exposes VITE_* variables to the browser)
# ============================================================

# Base URL of the FastAPI service.
VITE_API_URL=http://127.0.0.1:8000

# Never put secrets in VITE_* variables: they are bundled into the browser.
